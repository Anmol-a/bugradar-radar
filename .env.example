# Copy this file to ".env" (same folder) and paste your key after the "=".
# .env is git-ignored: the key never goes into git or into chat.

# Default LLM (30 Oct): Claude Haiku 5.5, paid by the Max plan's $100/month API credits. The spend guard stops all AI
# at $3 a day / $90 a month across every machine (radar/healing/budget.py; needs BUGRADAR_KEY for the shared ledger,
# otherwise a $0.50 cap per process).
ANTHROPIC_API_KEY=
# Fallback only (used when no ANTHROPIC_API_KEY): OpenAI gpt-5-mini (15/15 on llm-check, 5 Oct).
OPENAI_API_KEY=

# Optional: switch model or provider later with one line, nothing else changes.
# RADAR_LLM_MODEL=gpt-4o-mini   # cheaper fallback (14/15 on llm-check)
# RADAR_LLM_PROVIDER=openai_compat   # Gemini / DeepSeek via their OpenAI-compatible endpoints:
# RADAR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# RADAR_LLM_API_KEY=
# RADAR_LLM_MODEL=gemini-2.5-flash-lite
